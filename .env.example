# Copy to .env for local runs. Every variable maps 1:1 to app/config.py Settings. Placeholders only.

# --- auth (required unless FAKE_ENGINE=1, which defaults them to dev-token / dev-key) ---
CONTROL_TOKEN=change-me-control-token
OVERLAY_KEY=change-me-overlay-key

# --- reader (unset ANTHROPIC_API_KEY -> rules-only reader) ---
ANTHROPIC_API_KEY=
READER_MODEL=claude-haiku-4-5-20251001
READER_TIMEOUT_S=1.5
READER_CACHE_SIZE=512

# --- engine ---
FAKE_ENGINE=0
EMA_WEIGHTS_DIR=/opt/weights
EMA_BATCH_SIZE=1
TORCH_NUM_THREADS=2
SAMPLE_RATE=24000
# SPEECH_SPEED=0.85     # normally set in app/settings.yaml; an env/.env value overrides the YAML (0.25 .. 4)
# SETTINGS_PATH=        # tunables YAML (default: app/settings.yaml inside the package; empty = none; k3s: /config/settings.yaml)

# --- kick event mapping ---
KICK_BROADCASTER_USER_ID=0
MIN_KICKS=1
REWARD_TITLE=TTS
REWARD_STATUSES=pending,accepted
COMMAND_PREFIX=!tts
COMMAND_ROLES=broadcaster,moderator,subscriber
COMMAND_COOLDOWN_S=30

# --- queue / text limits ---
MAX_TEXT_CHARS=200
MAX_QUEUE=50
MAX_ITEM_AGE_S=600
BLOCKLIST=
# PRONOUNCE_PATH=   (default: app/reader/pronounce.yaml inside the package; set only to override, e.g. the ConfigMap mount)

# --- kick webhook verification ---
KICK_PUBLIC_KEY_URL=https://api.kick.com/public/v1/public-key
KICK_PUBLIC_KEY_PEM=

# --- overlay pacing ---
WS_PING_INTERVAL_S=20
ACK_GRACE_S=2.0

# --- panel login (/panel): Kick and/or Discord OAuth. A provider is offered only when both values are set ---
# Kick: the same developer app as kick_subscribe.py; its redirect URL in the portal must be <PUBLIC_BASE_URL>/auth/kick/callback
KICK_CLIENT_ID=your-kick-app-client-id
KICK_CLIENT_SECRET=your-kick-app-client-secret
# Discord: https://discord.com/developers/applications -> OAuth2 -> redirect <PUBLIC_BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=your-discord-app-client-id
DISCORD_CLIENT_SECRET=your-discord-app-client-secret
# PUBLIC_BASE_URL=https://anildev.io/tts   # what the browser sees (cluster: set in deploy/deployment.yaml); empty = request origin (local)
# SESSION_SECRET=                          # signs the panel cookies; empty = derived from CONTROL_TOKEN
# PANEL_ALLOWED_USERS=kick:anildev         # normally in app/settings.yaml; the KICK_BROADCASTER_USER_ID account is always allowed
# PANEL_SESSION_TTL_S=604800

LOG_LEVEL=INFO

